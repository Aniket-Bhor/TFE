# ─────────────────────────────────────────────────────────────
# The Fifth Element — Local Development Environment Variables
# Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────────

PORT=3000

# Firebase Realtime Database URL
# Format: https://your-project-default-rtdb.firebaseio.com/
FIREBASE_DATABASE_URL=

# Firebase Service Account JSON (paste the entire JSON as a single line string)
# Format: {"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT=
